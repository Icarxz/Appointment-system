# Copy to .env and fill in. Never commit the real .env.
MONGO_URI=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# --- School Google sign-in ---
# OAuth "Web application" client ID from Google Cloud Console (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# School email domain(s), comma-separated, without "@" (e.g. antiquespride.edu.ph). Others are rejected.
ALLOWED_EMAIL_DOMAIN=
# School accounts that become ADMIN on first sign-in (comma-separated)
ADMIN_EMAILS=

# --- Email copies of notifications (approved, declined, 1-hour reminder, appeals...) ---
# A Gmail account used only to SEND, with 2-step verification on and a 16-character "App password".
# Without these two, emails are printed in the server console instead of sent.
EMAIL_USER=
EMAIL_APP_PASSWORD=
# --- OR send through the Brevo HTTP API (use this on hosts that block SMTP, e.g. Render's free tier) ---
# Brevo > SMTP & API > create an API key with "Transactional email" = All (everything else None). Never commit it.
# The sender must be verified in Brevo > Settings > Senders, domains, IPs. Brevo wins when both Brevo and Gmail are set.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=CCIS Sync
# Optional. Defaults: smtp.gmail.com, port 465, secure (TLS). If port 465 is blocked on a network try 587 + false.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# Check the settings any time with:  npm run check-email  (add an address to send a real test message)
# Set to off to stop emailing notifications (in-app notifications are unaffected)
# EMAIL_NOTIFICATIONS=off
